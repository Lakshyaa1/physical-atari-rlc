{
  "_comment": [
    "Fast smoke test: does the whole learning stack actually run?",
    "Not a training run -- far too short to learn anything. Use it to check that",
    "torch, ale-py, the agent, and the harness all work before committing hours",
    "to a real run, and to confirm a new machine is set up correctly.",
    "",
    "ring_size is deliberately tiny (5,000 frames = 0.23 GiB instead of the",
    "default 400,000 = 18.31 GiB) so this runs on any machine, including CPU-only",
    "laptops with a couple of GB free.",
    "",
    "  python3 learn_policy.py --config experiment_configs/agent_action_input_sim_smoke.json --run 0"
  ],
  "exp_name": ["smoke"],
  "checkpoint_dir": ["./checkpoints"],
  "module_name": ["agents.agent_action_input"],
  "obs_size": [128],
  "obs_channels": [3],
  "base_channels": [24],
  "ring_size": [5000],
  "policy_skip": [2],
  "train_skip": [4],
  "observation_ema_log2": [-3],
  "momentum": [0.9],
  "lr_log2": [-14],
  "lr_linear_log2": [-17],
  "explore_log2": [-6],
  "target_model_log2": [5],
  "train_batch": [16],
  "train_reps": [1],
  "multisteps": [12],
  "discount": [0.99],
  "online_samples": [4],
  "action_encoding": [1],
  "action_ema_rate": [0.875],
  "action_steps": [4],
  "action_layers": [2],
  "game": ["ms_pacman"],
  "seed": [0],
  "max_frames_without_reward": [18000],
  "store_weights": [true],
  "load_weights": [false],
  "delay_learning_by_steps": [0],
  "steps": [300],
  "eval_steps": [50],
  "device": ["cpu"],
  "train": [true],
  "fps": [30],
  "latency_model": [false],
  "latency_model_path": ["./sim_env/robotroller_model_weights.npz"],
  "env": ["sim"],
  "use_reduced_action_set": [true]
}
